{
  "name": "capri-desktop",
  "version": "0.4.4",
  "description": "Capri, the Project Capricorn construct, living on your desktop and narrating what Claude Code is doing.",
  "author": "mochiiwuff",
  "repository": "github:mochiiwuff/capri-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "hooks:codex:install": "node scripts/install-codex-hooks.js",
    "hooks:codex:uninstall": "node scripts/install-codex-hooks.js --uninstall",
    "hooks:agy:install": "node scripts/install-hooks-agy.js",
    "hooks:agy:uninstall": "node scripts/install-hooks-agy.js --uninstall",
    "check:llm": "node scripts/check-llm.js",
    "test:hooks": "node --test tests/hooks.test.js",
    "dist": "electron-builder --win",
    "start:linux": "node scripts/start-linux.js",
    "dev:linux": "node scripts/start-linux.js --dev",
    "install:linux": "node scripts/install-linux.js",
    "check:linux": "node scripts/check-linux.js",
    "test": "node --test tests/*.test.js",
    "test:linux": "node --test tests/linux.test.js",
    "dist:linux": "electron-builder --linux dir --config.electronDist=/usr/lib/electron42 --config.electronVersion=42.11.18"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1",
      "src/main/linux-desktop.py",
      "src/main/linux-media.py",
      "src/main/kwin.js",
      "src/main/linux_input.py"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Capri",
      "artifactName": "Capri-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Utility",
      "executableName": "capri",
      "icon": "assets/icons/capri.png"
    },
    "extraResources": [
      {
        "from": "assets/icons/capri.png",
        "to": "capri.png"
      }
    ]
  }
}
